# Copy to project root as .env.local (same variable names).

# Backend. Local: Nest in ../server on port 3001. Production: your deployed API origin.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Local Next is port 3000 (`npm run dev`). Production: https://apnizaroorat.com
# Optional: canonical public URL (no trailing slash). Production default is https://apnizaroorat.com
# On Vercel Production, set this explicitly for safety:
# NEXT_PUBLIC_SITE_URL=https://apnizaroorat.com
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
# Office address (contact page). Default: Subhash Chowk, Jaipur, Rajasthan 302002
NEXT_PUBLIC_CONTACT_ADDRESS=
# Phone is fixed in app/config/publicEnv.ts (PUBLIC_CONTACT_PHONE). This key is unused.
NEXT_PUBLIC_CONTACT_PHONE=
# Google Maps iframe URL. Default embeds Subhash Chowk, Jaipur 302002.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
NEXT_PUBLIC_INDIA_MAP_SVG_URL=
NEXT_PUBLIC_INDIA_MAP_FALLBACK_SVG_URL=

# Random string, min 16 chars — signs admin session cookie (httpOnly).
ADMIN_SESSION_SECRET=
# Must match Nest server ADMIN_INTERNAL_KEY (required in production for admin CRUD + customer applications).
ADMIN_INTERNAL_KEY=
# Optional: HMAC for x-admin-actor (defaults to ADMIN_INTERNAL_KEY; must match Nest).
# ADMIN_ACTOR_SECRET=
# Optional: HMAC for customer_session cookie (defaults exist for local; set in production).
# CUSTOMER_SESSION_SECRET=
# Optional (local dev only): prefills /admin/login inputs; production builds ignore these.
# NEXT_PUBLIC_ADMIN_LOGIN_PREFILL_EMAIL=

# Firebase Web Phone Auth — project azapp-77130 (az_web OTP, SMS via Firebase only)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyA1ommyharuXqAyxwRpnCEYc0CR7KG2rUU
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=azapp-77130.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=azapp-77130
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=azapp-77130.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=33994590102
NEXT_PUBLIC_FIREBASE_APP_ID=1:33994590102:web:db620f6a678378b499bfb7
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-KXXTJW6FPD
